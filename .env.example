# Copy to .env locally if you want shell helpers to source it.
# Do not commit .env or real token values.

# GPU selection for B200 smoke runs.
CUDA_VISIBLE_DEVICES=0,1,2,3

# W&B online logging. WANDB_API_KEY must be exported in the shell before training.
WANDB_PROJECT=malware-analysis-llm
WANDB_LOG_MODEL=false
WANDB_WATCH=false
WANDB_API_KEY=

# Hugging Face access. Set only when gated models or datasets require it.
HF_TOKEN=

# Local project paths.
LLAMAFACTORY_DIR=LLaMA-Factory
DATASET_OUTPUT_DIR=data/processed
ZIP_EXTRACT_DIR=data/extracted/security_archives
MODEL_ROOT=model
BASE_MODEL_DIR=model/base
ADAPTER_OUTPUT_DIR=model/adapters
CHECKPOINT_OUTPUT_DIR=model/checkpoints
RUNS_OUTPUT_DIR=model/runs
WANDB_DIR=model/wandb

# Experiment outputs stay local unless explicitly curated.
experiments/*
!experiments/.gitkeep

# OS/editor files
.DS_Store

# Personal harness: local-only runtime state
/.active-profile
/.harness-local/
/.codex/agents/*.toml

# Machine-private files and root storage symlinks must stay out of Git.
/.private/
/.local/
/.secrets/
.ssh/
*.pem
*.key
*.ppk
id_rsa
id_ed25519
/data
/model
/artifact
/outputs
/Data
